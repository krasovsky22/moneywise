# Copy to .env and fill in values. Never commit .env.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moneywise

# Security — generate with: openssl rand -hex 32
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# AI parsing — leave blank to run in mock mode (no API calls, 0 transactions returned)
OPENAI_API_KEY=
CONFIDENCE_THRESHOLD=0.7
AI_MODEL=gpt-5-mini

# App metadata
ENVIRONMENT=development
APP_VERSION=0.1.0
