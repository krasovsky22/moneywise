# Copy to .env and fill in values. Never commit .env.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moneywise

# Security — generate with: openssl rand -hex 32
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# Plaid Sandbox — https://dashboard.plaid.com
PLAID_SANDBOX_CLIENT_ID=
PLAID_SANDBOX_SECRET=
# Plaid Production — https://dashboard.plaid.com
PLAID_PROD_CLIENT_ID=
PLAID_PROD_SECRET=
# Encrypts Plaid access tokens at rest — if unset, tokens are stored in PLAINTEXT.
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=

# App metadata
ENVIRONMENT=development
APP_VERSION=0.1.0
