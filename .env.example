# Root .env.example — copy to .env and fill in values.
# This file is safe to commit. Never commit .env.

# Shared across apps
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moneywise
REDIS_URL=redis://localhost:6379

# Backend (also in apps/api/.env.example)
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ENVIRONMENT=development

# AI parsing (Epic 04) — leave blank to run in mock mode (no API calls, 0 transactions)
OPENAI_API_KEY=
# Override the default model (optional)
AI_MODEL=gpt-4o-mini
